@page "/admin/tournaments"
@page "/host/tournaments"
@page "/player/tournaments"
@page "/guest/tournaments"
@using Model
@inject UserSession Session

<PageTitle>Tournaments · Bracketly</PageTitle>
<RoleGuard AllowedRoles="@(new[] { UserRoles.SuperAdmin, UserRoles.Host, UserRoles.Player, UserRoles.Guest })">
    <WorkspaceShell Title="@(Session.RoleName == UserRoles.Guest || Session.RoleName == UserRoles.Player ? "Find a tournament" : "Tournament desk")" Subtitle="@(Session.RoleName == UserRoles.Host ? "Keep your events organized and your matches on schedule." : "Discover events and keep up with the competition.")">
        <div class="workspace-panel-heading directory-heading"><div><div class="workspace-eyebrow">@(Session.RoleName == UserRoles.Guest ? "COMMUNITY EVENTS" : "TOURNAMENTS")</div><h2>@(Session.RoleName == UserRoles.Host ? "Your tournaments" : Session.RoleName == UserRoles.SuperAdmin ? "All tournaments" : "Open for registration")</h2></div>@if (Session.RoleName == UserRoles.Host){<button class="button button-accent" type="button">＋ Create tournament</button>}</div>
        <section class="tournament-grid">
            <article class="tournament-card"><div class="tournament-card-art art-purple"><span>VALORANT</span><strong>OPEN<br />INVITATIONAL</strong><i>VI</i></div><div class="tournament-card-body"><div class="tournament-card-top"><span class="event-tag event-tag-purple">VALORANT</span><span class="status-pill status-live">Registration open</span></div><h3>Open Invitational</h3><p>Fast-paced 5v5 community bracket with a live final.</p><div class="tournament-card-meta"><span>◷ Nov 8, 2026</span><span>♙ 48 / 64 players</span></div><div class="tournament-card-bottom"><strong>$800 <small>prize pool</small></strong><a class="text-link" href="@(Session.RoleName == UserRoles.Guest ? "/register" : Session.RoleName == UserRoles.Host ? "/host/teams" : Session.RoleName == UserRoles.SuperAdmin ? "/admin/users" : "/player/teams")">@(Session.RoleName == UserRoles.Guest ? "Join to play" : Session.RoleName == UserRoles.Host ? "View teams" : Session.RoleName == UserRoles.SuperAdmin ? "Review event" : "View event") <span aria-hidden="true">→</span></a></div></div></article>
            <article class="tournament-card"><div class="tournament-card-art art-green"><span>FOOTBALL</span><strong>CITY FUTSAL<br />SERIES</strong><i>CF</i></div><div class="tournament-card-body"><div class="tournament-card-top"><span class="event-tag event-tag-green">FOOTBALL</span><span class="status-pill status-live">Registration open</span></div><h3>City Futsal Series</h3><p>Local teams compete in a weekend knockout series.</p><div class="tournament-card-meta"><span>◷ Nov 10, 2026</span><span>♙ 8 / 12 teams</span></div><div class="tournament-card-bottom"><strong>Free <small>entry</small></strong><a class="text-link" href="@(Session.RoleName == UserRoles.Guest ? "/register" : Session.RoleName == UserRoles.Host ? "/host/teams" : Session.RoleName == UserRoles.SuperAdmin ? "/admin/users" : "/player/teams")">@(Session.RoleName == UserRoles.Guest ? "Join to play" : Session.RoleName == UserRoles.Host ? "View teams" : Session.RoleName == UserRoles.SuperAdmin ? "Review event" : "View event") <span aria-hidden="true">→</span></a></div></div></article>
            <article class="tournament-card"><div class="tournament-card-art art-orange"><span>CHESS</span><strong>CAMPUS<br />CHESS OPEN</strong><i>CC</i></div><div class="tournament-card-body"><div class="tournament-card-top"><span class="event-tag event-tag-purple">CHESS</span><span class="status-pill">Starting soon</span></div><h3>Campus Chess Open</h3><p>Three-day Swiss format for players of every level.</p><div class="tournament-card-meta"><span>◷ Nov 12, 2026</span><span>♙ 24 / 32 players</span></div><div class="tournament-card-bottom"><strong>$250 <small>prize pool</small></strong><a class="text-link" href="@(Session.RoleName == UserRoles.Guest ? "/register" : Session.RoleName == UserRoles.Host ? "/host/teams" : Session.RoleName == UserRoles.SuperAdmin ? "/admin/users" : "/player/teams")">@(Session.RoleName == UserRoles.Guest ? "Join to play" : Session.RoleName == UserRoles.Host ? "View teams" : Session.RoleName == UserRoles.SuperAdmin ? "Review event" : "View event") <span aria-hidden="true">→</span></a></div></div></article>
        </section>
        <p class="mock-data-note">Sample tournament data for stage 9 · sign-ups and management actions are not connected yet.</p>
    </WorkspaceShell>
</RoleGuard>
