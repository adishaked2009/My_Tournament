@page "/guest"
@using Model

<PageTitle>Discover tournaments · Bracketly</PageTitle>
<RoleGuard AllowedRoles="@(new[] { UserRoles.Guest })">
    <WorkspaceShell Title="Find your next challenge" Subtitle="Explore the community and see what’s coming up.">
        <div class="workspace-eyebrow">GUEST WORKSPACE</div>
        <section class="guest-welcome-panel"><div><span class="panel-kicker">YOUR NEXT GAME STARTS HERE</span><h2>Great tournaments.<br />Good people. One place.</h2><p>Browse upcoming events and create a player account when you’re ready to join in.</p><a class="button button-accent" href="/register">Create a player account</a></div><div class="guest-art" aria-hidden="true"><span class="guest-art-ring"></span><span class="guest-art-dot"></span><span class="guest-art-card">NEXT<br /><strong>5v5</strong></span></div></section>
        <section class="workspace-panel">
            <div class="workspace-panel-heading"><div><span class="panel-kicker">OPEN TO EVERYONE</span><h2>Upcoming tournaments</h2></div><a class="text-link" href="/guest/tournaments">See all events <span aria-hidden="true">→</span></a></div>
            <div class="event-list-row"><div class="event-list-mark mark-purple">VI</div><div class="event-list-copy"><strong>Open Invitational</strong><span>Valorant · Nov 8</span></div><span class="event-list-count">48 / 64 players</span><span class="status-pill status-live">Open</span></div>
            <div class="event-list-row"><div class="event-list-mark mark-green">CF</div><div class="event-list-copy"><strong>City Futsal Series</strong><span>Football · Nov 10</span></div><span class="event-list-count">8 / 12 teams</span><span class="status-pill status-live">Open</span></div>
            <div class="event-list-row"><div class="event-list-mark mark-orange">CO</div><div class="event-list-copy"><strong>Campus Chess Open</strong><span>Chess · Nov 12</span></div><span class="event-list-count">24 / 32 players</span><span class="status-pill status-live">Open</span></div>
        </section>
    </WorkspaceShell>
</RoleGuard>

@code { [Inject] private UserSession Session { get; set; } = default!; }
