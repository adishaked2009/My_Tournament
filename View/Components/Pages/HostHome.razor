@page "/host"
@using Model

<PageTitle>Organizer dashboard · Bracketly</PageTitle>
<RoleGuard AllowedRoles="@(new[] { UserRoles.Host })">
    <WorkspaceShell Title="Organizer dashboard" Subtitle="Your tournaments are moving. Here’s your organizer snapshot.">
        <div class="workspace-eyebrow">ORGANIZER WORKSPACE</div>
        <section class="metric-grid" aria-label="Organizer overview">
            <article class="metric-card"><span>Running tournaments</span><strong>03</strong><small>1 live right now</small></article>
            <article class="metric-card"><span>Total registrations</span><strong>186</strong><small class="metric-positive">↑ 24 this week</small></article>
            <article class="metric-card"><span>Matches to schedule</span><strong>08</strong><small class="metric-attention">Across 2 events</small></article>
        </section>
        <section class="workspace-panel">
            <div class="workspace-panel-heading"><div><span class="panel-kicker">YOUR EVENTS</span><h2>Keep the next match moving</h2></div><a class="text-link" href="/host/tournaments">Manage tournaments <span aria-hidden="true">→</span></a></div>
            <div class="event-list-row"><div class="event-list-mark mark-purple">SC</div><div class="event-list-copy"><strong>Sunday 5v5 Cup</strong><span>Football · Starts Nov 9</span></div><span class="event-list-count">12 / 16 teams</span><span class="status-pill status-live">Registration open</span></div>
            <div class="event-list-row"><div class="event-list-mark mark-green">CC</div><div class="event-list-copy"><strong>Campus Chess Open</strong><span>Chess · Starts Nov 12</span></div><span class="event-list-count">24 / 32 players</span><span class="status-pill">In progress</span></div>
            <div class="event-list-row"><div class="event-list-mark mark-orange">CS</div><div class="event-list-copy"><strong>City Futsal Series</strong><span>Football · Starts Nov 16</span></div><span class="event-list-count">8 / 12 teams</span><span class="status-pill">Draft</span></div>
        </section>
        <section class="quick-link-grid">
            <a class="quick-link-card" href="/host/tournaments"><span class="quick-link-icon quick-link-icon-purple">◇</span><strong>Tournament desk</strong><span>Review entries and match schedules <b aria-hidden="true">→</b></span></a>
            <a class="quick-link-card" href="/host/teams"><span class="quick-link-icon">◎</span><strong>Teams &amp; roster</strong><span>See teams registered for your events <b aria-hidden="true">→</b></span></a>
        </section>
    </WorkspaceShell>
</RoleGuard>

@code { [Inject] private UserSession Session { get; set; } = default!; }
