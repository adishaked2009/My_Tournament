@page "/player"
@using Model

<PageTitle>Player dashboard · Bracketly</PageTitle>
<RoleGuard AllowedRoles="@(new[] { UserRoles.Player })">
    <WorkspaceShell Title="Your next match is waiting" Subtitle="Your teams, tournaments, and upcoming games in one place.">
        <div class="workspace-eyebrow">PLAYER WORKSPACE</div>
        <section class="metric-grid" aria-label="Player overview">
            <article class="metric-card"><span>My tournaments</span><strong>02</strong><small>Both active this week</small></article>
            <article class="metric-card"><span>Next match</span><strong class="metric-word">Tomorrow</strong><small>6:30 PM · Court A</small></article>
            <article class="metric-card"><span>Team record</span><strong>5–1</strong><small class="metric-positive">Northside FC</small></article>
        </section>
        <section class="workspace-panel">
            <div class="workspace-panel-heading"><div><span class="panel-kicker">UP NEXT</span><h2>Your next match</h2></div><a class="text-link" href="/player/tournaments">Browse tournaments <span aria-hidden="true">→</span></a></div>
            <div class="next-match-card"><div><span class="match-date-chip">NOV 05 · 6:30 PM</span><h3>Sunday 5v5 Cup</h3><p>Semifinal · Court A</p></div><div class="next-match-score"><span class="team-token">N</span><strong>Northside</strong><b>VS</b><strong>East End</strong><span class="team-token team-token-purple">E</span></div></div>
        </section>
        <section class="quick-link-grid">
            <a class="quick-link-card" href="/player/tournaments"><span class="quick-link-icon quick-link-icon-purple">◇</span><strong>Find a tournament</strong><span>Explore events that are open to join <b aria-hidden="true">→</b></span></a>
            <a class="quick-link-card" href="/player/teams"><span class="quick-link-icon">◎</span><strong>My teams</strong><span>Check your roster and team activity <b aria-hidden="true">→</b></span></a>
        </section>
    </WorkspaceShell>
</RoleGuard>

@code { [Inject] private UserSession Session { get; set; } = default!; }
